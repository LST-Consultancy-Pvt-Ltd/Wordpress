# Control plane configuration. Copy to backend/.env (never commit the copy).
MONGO_URL=mongodb://localhost:27017
DB_NAME=site_autopilot
# Long random string: signs the app's own login sessions.
JWT_SECRET_KEY=
# Fernet key for bridge credentials and provider API keys at rest (required):
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# 1 (default) = no unattended writes to sites; 0 = allow policy-approved auto-apply and scheduled runs.
AUTOMATION_WRITES_FROZEN=1
CORS_ORIGINS=http://localhost:3000
# Optional providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
PAGESPEED_API_KEY=
